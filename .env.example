# LLM — OpenAI-compatible API.
# Point LLM_BASE_URL at OpenAI or your internal gateway (e.g. MMX); the code
# does not care, only that the endpoint speaks the OpenAI chat completions API.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# GitHub — Personal Access Token with scope `security_events` (Dependabot alerts)
# plus `public_repo` (issues). Swap for a GitHub App in production.
GITHUB_TOKEN=ghp_...
